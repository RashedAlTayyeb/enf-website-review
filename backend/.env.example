# Runtime
ENF_ENV=development
ENF_ALLOWED_ORIGIN=http://127.0.0.1:5500
ENF_DB_PATH=backend/data/enf_donations.db

# PayTabs (Jordan-friendly option)
PAYTABS_BASE_URL=https://secure.paytabs.com
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
PAYTABS_CLIENT_KEY=

# Amazon Payment Services (APS)
APS_BASE_URL=https://sbpaymentservices.payfort.com
APS_ACCESS_CODE=
APS_MERCHANT_IDENTIFIER=
APS_SHA_REQUEST_PHRASE=
APS_SHA_RESPONSE_PHRASE=

# Webhook hardening
WEBHOOK_SHARED_SECRET=

# Admin / Donor Sessions
DONOR_SESSION_TTL_HOURS=720
ADMIN_SESSION_TTL_HOURS=24
ENF_ADMIN_USERNAME=ADMIN
ENF_ADMIN_PASSWORD=
